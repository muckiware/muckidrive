# Base entries for every muckidrive project. Symfony Flex appends and
# maintains its own `###> vendor/package ###` blocks below.
/vendor/
/.env
/.env.dev
/.env.test
/auth.json
/install.lock
/parameters.txt
/.uniqueid.txt
.DS_Store
**/.DS_Store
**/.phpunit.result.cache
**/node_modules/
/.idea/

###> shopware/core ###
.env.local
.env.local.php
.env.*.local
/public/bundles/*
/public/media/*
/public/theme/*
/public/thumbnail/*
/public/sitemap/*
/files/*
!/files/.htaccess
/var/*
!/var/.htaccess
/auth.json
/install.lock
/public/asset-manifest.json
###< shopware/core ###

###> phpstan/phpstan ###
phpstan.neon
###< phpstan/phpstan ###

###> phpunit/phpunit ###
/phpunit.xml
.phpunit.result.cache
###< phpunit/phpunit ###

# --- muckidrive repository / dev workspace only -------------------------------
# The skeleton repository does not commit a lock file. In your own project,
# remove the next line and commit composer.lock.
/composer.lock
/.ddev/
/.playwright-mcp/
/custom/muckiware/core.zip
/custom/plugins/MuckiLogPlugin/logfile.txt

# MuckiSafe plugins and the restic library are cloned at Docker build time,
# they are NOT part of the muckidrive platform
/custom/plugins/MuckiFacilityPlugin/
/custom/plugins/MuckiLogPlugin/
/custom/muckiware/restic/
