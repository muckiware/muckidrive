# muckidrive environment configuration
# Copy to .env and fill in real values:   cp .env.example .env

# --- Application --------------------------------------------------------------
# dev for development, prod for production
APP_ENV=dev

# Generate with:  openssl rand -hex 32
APP_SECRET=

# Public base URL of the application
APP_URL=http://localhost

# Random instance identifier. Generate with:  openssl rand -base64 24 | tr -d /+
INSTANCE_ID=

# --- Database -------------------------------------------------------------------
DATABASE_URL=mysql://muckidrive:muckidrive@127.0.0.1:3306/muckidrive

# --- Mail ------------------------------------------------------------------------
# Example SMTP:  smtp://user:pass@smtp.example.com:587
MAILER_DSN=null://null

# --- muckidrive ------------------------------------------------------------------
# Absolute path to the project root (used by route imports and the plugin loader).
# Inside DDEV this is /var/www/html.
MUCKIWARE_ROOT=
