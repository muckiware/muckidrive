{
    "name": "muckiware/muckidrive",
    "description": "Muckidrive - Shopware 6.7 Core as an application framework, without shop context",
    "license": "MIT",
    "type": "project",
    "require": {
        "composer-runtime-api": "^2.0",
        "muckiware/core": ">=0.0.2 <0.2",
        "muckiware/master": ">=0.0.1 <0.1",
        "shopware/conflicts": "*",
        "symfony/flex": "~2"
    },
    "repositories": [
        {
            "type": "path",
            "url": "custom/muckiware/*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "custom/plugins/*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "custom/static-plugins/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true,
            "php-http/discovery": false
        },
        "audit": {
            "ignore": {
                "PKSA-s52d-n7sx-trsg": "mcp/sdk (required by shopware/core) - accepted until shopware/core ships a fixed mcp/sdk"
            }
        },
        "optimize-autoloader": true,
        "sort-packages": true,
        "github-protocols": [
            "https"
        ]
    },
    "scripts": {
        "auto-scripts": {
            "assets:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "endpoint": [
                "https://raw.githubusercontent.com/muckiware/recipes/flex/main/index.json",
                "https://raw.githubusercontent.com/shopware/recipes/flex/main/index.json",
                "flex://defaults"
            ]
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.5"
    }
}
