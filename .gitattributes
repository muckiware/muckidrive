# Exclude repository-only files from Composer dist archives (create-project,
# `composer archive`, Packagist dist downloads = GitHub zipballs = `git archive`).
#
# This repository is both the `muckiware/muckidrive` skeleton and the
# maintainer's development workspace. Everything a Symfony Flex recipe
# generates (muckiware/recipes, shopware/recipes, symfony/recipes) stays
# tracked here for development, but is NOT shipped: a project created via
# `composer create-project` starts without symfony.lock, so Flex runs all
# recipes and the generated files stay updatable via `composer recipes:update`.
# See UPGRADE.md.
#
# Keep this list in sync with the `files` lists in symfony.lock. Verify with:
#   git archive HEAD | tar -t

# --- Maintainer tooling and docs ---------------------------------------------
/.github export-ignore
/changelog export-ignore
/CLAUDE.md export-ignore
/.gitattributes export-ignore
/compose.override.yaml export-ignore
# Dev workspace ignores (composer.lock, .ddev, MuckiSafe build artefacts). A new
# project gets its .gitignore from the recipes (muckiware/core adds /vendor/).
/.gitignore export-ignore

# --- Flex state: without it, every recipe runs on create-project -------------
/symfony.lock export-ignore

# --- Generated by the muckiware/core and muckiware/master recipes ------------
/.htaccess export-ignore
/bin export-ignore
/public export-ignore
/files export-ignore
/var export-ignore
/custom/.htaccess export-ignore
/custom/apps export-ignore

# --- Generated by other recipes (see `files` in symfony.lock) -----------------
# Flex: config/bundles.php; symfony/framework-bundle: config/services.yaml,
# src/Controller/.gitignore; symfony/routing: config/routes.yaml;
# muckiware/core: config/jwt/.gitignore; symfony/lock, php-http/discovery,
# nyholm/psr7: config/packages/*
/config export-ignore
/src export-ignore
# phpunit/phpunit: phpunit.xml.dist, tests/bootstrap.php, .env.test
/phpunit.xml.dist export-ignore
/tests export-ignore
# phpstan/phpstan: phpstan.dist.neon
/phpstan.dist.neon export-ignore

# --- Vendored packages and local plugins (dev workspace only) ----------------
# The directory placeholders themselves stay in the dist, because the `path`
# repositories in composer.json point at these directories.
/custom/muckiware/** export-ignore
/custom/muckiware/.gitignore -export-ignore
/custom/plugins/** export-ignore
/custom/plugins/.gitignore -export-ignore
/custom/static-plugins/** export-ignore
/custom/static-plugins/.gitignore -export-ignore
